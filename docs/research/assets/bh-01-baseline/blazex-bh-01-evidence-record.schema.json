{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-01/evidence-record-1.0.0.json",
  "title": "BlazeX BH-01 Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "state",
    "title",
    "owner_role",
    "recorded_at",
    "observed_at",
    "source_revision",
    "environment_refs",
    "tool_identities",
    "requirement_refs",
    "reciprocal_links",
    "command_refs",
    "input_hashes",
    "output_hashes",
    "raw_evidence_refs",
    "normalization",
    "limitations",
    "supersedes",
    "invalidates",
    "retention",
    "outcome",
    "review"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^BX-BH01-(ENV|COMMAND|LOG|ARTIFACT|SCENARIO|TRACE|MEASUREMENT|REVIEW|FINDING|RISK|EXCEPTION|DECISION)-[A-Z0-9][A-Z0-9.-]*$"},
    "record_type": {
      "enum": [
        "environment-fingerprint",
        "command",
        "log",
        "artifact",
        "scenario",
        "trace",
        "measurement",
        "review",
        "finding",
        "risk",
        "exception",
        "decision"
      ]
    },
    "state": {
      "enum": [
        "planned",
        "observed",
        "passed",
        "failed",
        "blocked",
        "conditional",
        "unsupported",
        "untested",
        "superseded",
        "invalidated"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "owner_role": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tool_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "requirement_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reciprocal_links": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "command_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "input_hashes": {"$ref": "#/$defs/hashRecords"},
    "output_hashes": {"$ref": "#/$defs/hashRecords"},
    "raw_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "normalization": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "method"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "invalidates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "minimum_days", "immutable_raw_evidence"],
      "properties": {
        "class": {"enum": ["phase", "milestone", "release", "permanent"]},
        "minimum_days": {"type": ["integer", "null"], "minimum": 1},
        "immutable_raw_evidence": {"const": true}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "expected", "observed"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "observed": {"type": ["string", "null"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reviewer_role", "reviewed_at", "disposition"],
      "properties": {
        "required": {"type": "boolean"},
        "reviewer_role": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "disposition": {"enum": ["pending", "accepted", "rejected", "changes-required", "not-required"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["observed", "passed", "failed", "blocked", "conditional", "unsupported"]}}},
      "then": {
        "properties": {
          "observed_at": {"type": "string", "format": "date-time"},
          "input_hashes": {"minItems": 1},
          "output_hashes": {"minItems": 1},
          "raw_evidence_refs": {"minItems": 1},
          "normalization": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "superseded"}}},
      "then": {"properties": {"supersedes": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"state": {"const": "invalidated"}}},
      "then": {"properties": {"invalidates": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "hashRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
