{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-01/governance-1.0.0.json",
  "title": "BlazeX BH-01 Evidence and Stop Governance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_version",
    "governance_id",
    "status",
    "evidence_record_schema",
    "state_vocabulary",
    "evidence_types",
    "authority_assignments",
    "finding_severities",
    "blocker_rules",
    "stop_go_policy",
    "invalidation_policy",
    "bounded_mitigation_policy",
    "reapproval_triggers",
    "prohibited_governance_actions"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "governance_version": {"const": "0.1.0"},
    "governance_id": {"const": "BX-BH01-EVIDENCE-GOVERNANCE-0.1"},
    "status": {"const": "active-phase-1"},
    "evidence_record_schema": {"type": "string", "minLength": 1},
    "state_vocabulary": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_types": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id_prefix", "default_owner", "retention_class"],
        "properties": {
          "type": {"type": "string"},
          "id_prefix": {"type": "string", "pattern": "^BX-BH01-[A-Z]+-$"},
          "default_owner": {"type": "string"},
          "retention_class": {"enum": ["phase", "milestone", "release", "permanent"]}
        }
      }
    },
    "authority_assignments": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "owner", "escalates_to", "stop_authority"],
        "properties": {
          "domain": {"type": "string"},
          "owner": {"type": "string"},
          "escalates_to": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "stop_authority": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "finding_severities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "phase_effect", "review_required"],
        "properties": {
          "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
          "phase_effect": {"enum": ["record", "track", "mitigate", "conditional-stop", "stop"]},
          "review_required": {"type": "boolean"}
        }
      }
    },
    "blocker_rules": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
    "stop_go_policy": {"$ref": "#/$defs/policy"},
    "invalidation_policy": {"$ref": "#/$defs/policy"},
    "bounded_mitigation_policy": {"$ref": "#/$defs/policy"},
    "reapproval_triggers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "change", "approvers", "invalidation_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^BX-BH01-REAPPROVAL-[A-Z-]+$"},
          "change": {"type": "string", "minLength": 1},
          "approvers": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "invalidation_required": {"const": true}
        }
      }
    },
    "prohibited_governance_actions": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "required_record_types", "rules"],
      "properties": {
        "owner": {"type": "string"},
        "required_record_types": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "rules": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
