{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-01/phase-09-rerun-comparison-1.0.0.json",
  "title": "BlazeX BH-01 Phase 9 Representative Rerun Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "status", "source_revision", "policy", "inputs", "identity_checks", "comparisons", "drift_count", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^BX-BH01-PHASE9-RERUN-COMPARISON(?:-[A-Z0-9.-]+)?-0\\.1$"},
    "status": {"enum": ["observed-within-development-tolerance", "observed-drift"]},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy": {"type": "object", "required": ["median_relative_floor", "p95_relative_floor", "variance_multiplier_median", "variance_multiplier_p95", "near_zero_absolute_ms", "excluded_metrics"]},
    "inputs": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["role", "path", "sha256", "environment_id", "source_revision"]}},
    "identity_checks": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["environment_id", "browser_binary_match", "profile_manifest_match", "environment_match"]}},
    "comparisons": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["environment_id", "metric_id", "scenario", "cache_state", "primary", "rerun", "tolerance", "status"]}},
    "drift_count": {"type": "integer", "minimum": 0},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
