{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-01/phase-09-build-run-1.0.0.json",
  "title": "BlazeX BH-01 Phase 9 Build Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "captured_at", "source_revision", "environment_id", "command", "clock", "discarded_warmups", "samples", "output_manifest_sha256", "failures", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"const": "BX-BH01-PHASE9-RUN-BUILD-LINUX-0.1"},
    "status": {"enum": ["observed", "failed"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_id": {"type": "string", "pattern": "^BX-BH01-ENV-[A-Z0-9.-]+$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "clock": {"const": "python-time-perf-counter-monotonic"},
    "discarded_warmups": {"const": 1},
    "samples": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "seconds", "manifest_sha256", "status"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 1},
          "seconds": {"type": "number", "minimum": 0},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"const": "passed"}
        }
      }
    },
    "output_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failures": {"type": "array", "maxItems": 0},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
