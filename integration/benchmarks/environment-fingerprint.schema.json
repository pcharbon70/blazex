{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-01/environment-fingerprint-1.0.0.json",
  "title": "BlazeX BH-01 Environment Fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_id", "captured_at", "source_revision", "operating_system", "architecture", "hardware", "browser", "network", "toolchain", "raw_evidence_refs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "environment_id": {"type": "string", "pattern": "^BX-BH01-ENV-[A-Z0-9.-]+$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operating_system": {"type": "object", "minProperties": 3},
    "architecture": {"type": "string", "minLength": 1},
    "hardware": {"type": "object", "minProperties": 2},
    "browser": {"type": ["object", "null"]},
    "network": {"type": ["object", "null"]},
    "toolchain": {"type": "array", "items": {"type": "object", "minProperties": 2}},
    "raw_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
