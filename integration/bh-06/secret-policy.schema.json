{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "key_fragments", "literal_rules", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
    "key_fragments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}},
    "literal_rules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "literal", "reason"], "properties": {"id": {"type": "string"}, "literal": {"type": "string", "minLength": 4, "maxLength": 128}, "reason": {"type": "string", "minLength": 1, "maxLength": 256}}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_inputs", "max_input_bytes", "max_total_bytes", "max_findings"], "properties": {"max_inputs": {"type": "integer", "minimum": 1}, "max_input_bytes": {"type": "integer", "minimum": 1}, "max_total_bytes": {"type": "integer", "minimum": 1}, "max_findings": {"type": "integer", "minimum": 1}}}
  }
}
