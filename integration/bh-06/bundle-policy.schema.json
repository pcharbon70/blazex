{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_id", "base_bundle_id", "startup_modules", "features", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "policy_id": {"type": "string"}, "base_bundle_id": {"type": "string"},
    "startup_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "features": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "entrypoint_ids", "modules"], "properties": {"id": {"type": "string"}, "entrypoint_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_bundles", "max_inputs", "max_input_bytes", "max_total_bytes"], "properties": {"max_bundles": {"type": "integer", "minimum": 2}, "max_inputs": {"type": "integer", "minimum": 1}, "max_input_bytes": {"type": "integer", "minimum": 1}, "max_total_bytes": {"type": "integer", "minimum": 1}}}
  }
}

