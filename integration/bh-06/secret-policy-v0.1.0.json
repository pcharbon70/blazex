{
  "schema_version": "1.0.0",
  "policy_id": "blazex.bh06.secret-exclusion/1",
  "key_fragments": ["api_key", "credential", "password", "private_key", "secret", "token"],
  "literal_rules": [
    {"id": "aws-access-key", "literal": "AKIA", "reason": "AWS access-key prefix"},
    {"id": "github-token", "literal": "ghp_", "reason": "GitHub personal-token prefix"},
    {"id": "pem-private-key", "literal": "-----BEGIN PRIVATE KEY-----", "reason": "unencrypted private-key header"},
    {"id": "slack-bot-token", "literal": "xoxb-", "reason": "Slack bot-token prefix"}
  ],
  "limits": {"max_inputs": 1000, "max_input_bytes": 16777216, "max_total_bytes": 67108864, "max_findings": 1024}
}
