{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","policy_id","compression","roles","budgets","limits"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"policy_id":{"type":"string","pattern":"^[a-z][a-z0-9._/-]{0,127}$"},
    "compression":{"type":"object","additionalProperties":false,"required":["algorithm","implementation","quality","repetitions"],"properties":{"algorithm":{"const":"brotli"},"implementation":{"const":"node-zlib"},"quality":{"const":11},"repetitions":{"type":"integer","minimum":3,"maximum":10}}},
    "roles":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","additionalProperties":false,"required":["owner","exposure"],"properties":{"owner":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"exposure":{"enum":["public","private-build-evidence"]}}}},
    "budgets":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","owner","metric","direction","threshold"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"owner":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"metric":{"enum":["decoded_bytes","brotli_bytes","source_map_bytes"]},"direction":{"enum":["at-most","exactly"]},"threshold":{"type":"integer","minimum":0}}}},
    "limits":{"type":"object","additionalProperties":false,"required":["max_artifacts","max_public_bytes","max_role_length","max_owner_length"],"properties":{"max_artifacts":{"type":"integer","minimum":1,"maximum":4096},"max_public_bytes":{"type":"integer","minimum":1},"max_role_length":{"type":"integer","minimum":1,"maximum":128},"max_owner_length":{"type":"integer","minimum":1,"maximum":128}}}
  }
}
