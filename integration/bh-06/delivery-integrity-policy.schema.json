{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "integrity_algorithm", "roles", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
    "integrity_algorithm": {"const": "sha384"},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cache_control", "cardinality"],
        "properties": {
          "cache_control": {"enum": ["no-store", "public, max-age=31536000, immutable"]},
          "cardinality": {"enum": ["exactly-one", "one-or-more"]}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_artifacts", "max_total_bytes", "max_role_length"],
      "properties": {
        "max_artifacts": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_total_bytes": {"type": "integer", "minimum": 1},
        "max_role_length": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    }
  }
}
