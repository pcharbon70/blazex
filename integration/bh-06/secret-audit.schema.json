{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "status", "policy_id", "policy_sha256", "public_config_sha256", "inputs", "findings", "summary", "clean"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "phase": {"const": 5}, "status": {"const": "complete"},
    "policy_id": {"type": "string"}, "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "public_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "array"}, "findings": {"type": "array"}, "summary": {"type": "object"}, "clean": {"type": "boolean"}
  }
}
