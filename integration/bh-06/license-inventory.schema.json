{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_sha256", "inputs", "components", "license_records", "build_lineage", "notices", "summary", "complete"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "bytes", "sha256", "component_id", "license_record_ids"], "properties": {"label": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "component_id": {"type": "string"}, "license_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
    "components": {"type": "array"},
    "license_records": {"type": "array"},
    "build_lineage": {"type": "array"},
    "notices": {"type": "array"},
    "summary": {"type": "object"},
    "complete": {"const": true}
  }
}
