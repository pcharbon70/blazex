{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "entrypoints", "required_public_roles", "required_private_roles", "required_evidence", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"},
    "entrypoints": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "module"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,127}$"}, "module": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,255}$"}}}},
    "required_public_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"}},
    "required_private_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"enum": ["reachability", "client_safety", "compatibility", "secret_audit", "license_inventory", "bundle_plan", "runtime_closure", "payload", "delivery_integrity"]}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_entrypoints", "max_artifacts", "max_evidence_categories"], "properties": {"max_entrypoints": {"type": "integer", "minimum": 1, "maximum": 1024}, "max_artifacts": {"type": "integer", "minimum": 1, "maximum": 4096}, "max_evidence_categories": {"type": "integer", "minimum": 1, "maximum": 32}}}
  }
}
