{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh01-phase10-ledger-closure-v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "status", "source_revision", "policy", "counts", "inputs", "proof_obligations", "risks", "stop_conditions", "findings", "exceptions", "decision_effect", "support_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"const": "BX-BH01-PHASE10-LEDGER-CLOSURE-0.1"},
    "status": {"const": "closed-with-bounded-conditions-and-deferrals"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_environment", "deferred_milestone", "deferred_is_pass", "deferred_is_active_blocker"],
      "properties": {
        "active_environment": {"const": "Linux x86-64 with Chrome and Firefox development evidence"},
        "deferred_milestone": {"const": "BH-22"},
        "deferred_is_pass": {"const": false},
        "deferred_is_active_blocker": {"const": false}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "proof_obligations", "risks", "stop_conditions", "findings", "exceptions"],
      "properties": {
        "inputs": {"const": 8},
        "proof_obligations": {"const": 10},
        "risks": {"const": 8},
        "stop_conditions": {"const": 5},
        "findings": {"const": 30},
        "exceptions": {"const": 0}
      }
    },
    "inputs": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/closure"}},
    "proof_obligations": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/proof"}},
    "risks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/risk"}},
    "stop_conditions": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/stop"}},
    "findings": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/finding"}},
    "exceptions": {"type": "array", "maxItems": 0},
    "decision_effect": {"const": "eligible-for-multidisciplinary-review-with-bounded-conditions"},
    "support_status": {"const": "unsupported"}
  },
  "$defs": {
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "state", "evidence", "outcome", "decision_effect"],
      "properties": {
        "id": {"type": "string"}, "owner": {"type": "string"},
        "state": {"enum": ["closed-passed", "closed-conditional", "closed-exact-pins-only", "closed-with-deferred-qualification"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outcome": {"type": "string", "minLength": 20}, "decision_effect": {"type": "string", "minLength": 10}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "state", "evidence", "outcome", "decision_effect", "scope", "stop_on_failure", "budget_refs", "acceptance_refs", "positive_and_negative_executed"],
      "properties": {
        "id": {"type": "string"}, "owner": {"type": "string"},
        "state": {"enum": ["closed-passed", "closed-conditional", "closed-with-deferred-qualification"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outcome": {"type": "string", "minLength": 20}, "decision_effect": {"type": "string", "minLength": 10},
        "scope": {"enum": ["active-linux", "deferred-bh22"]}, "stop_on_failure": {"const": true},
        "budget_refs": {"type": "array"}, "acceptance_refs": {"type": "array", "minItems": 1},
        "positive_and_negative_executed": {"type": "boolean"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "state", "likelihood", "impact", "evidence", "mitigation", "residual_risk", "review_trigger", "decision_effect"],
      "properties": {
        "id": {"type": "string"}, "owner": {"type": "string"},
        "state": {"enum": ["accepted-residual", "deferred-bh22"]},
        "likelihood": {"enum": ["low", "medium", "high", "unknown-deferred"]},
        "impact": {"enum": ["low", "medium", "high", "critical", "unknown-deferred"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "mitigation": {"type": "string", "minLength": 20}, "residual_risk": {"type": "string", "minLength": 20},
        "review_trigger": {"type": "string", "minLength": 10}, "decision_effect": {"type": "string", "minLength": 10}
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "state", "evidence", "outcome"],
      "properties": {
        "id": {"type": "string"}, "owner": {"type": "string"},
        "state": {"enum": ["not-triggered", "conditionally-not-triggered"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outcome": {"type": "string", "minLength": 20}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "finding", "disposition", "owner", "decision_effect"],
      "properties": {
        "id": {"type": "string"}, "source": {"type": "string"}, "finding": {"type": "string", "minLength": 10},
        "disposition": {"enum": ["closed-active-pass", "resolved-and-retested", "accepted-bounded-condition", "accepted-residual-limitation", "deferred-bh22", "informational"]},
        "owner": {"type": "string"}, "decision_effect": {"type": "string", "minLength": 10}
      }
    }
  }
}
