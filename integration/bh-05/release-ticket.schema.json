{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-05/release-ticket-v1.json",
  "title": "BH-05 provider release-ticket observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "support_state", "deadline_ms", "page_size", "maximum_ticket_bytes", "samples"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": 17},
    "support_state": {"const": "unsupported"},
    "deadline_ms": {"const": 1000},
    "page_size": {"const": 64},
    "maximum_ticket_bytes": {"const": 4096},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runtime", "count", "elapsed_ms", "unresolved_identities", "ticket_preparations", "tickets_prepared", "ticket_preparation_failures", "ticket_bytes", "ticket_owner_fields"],
        "properties": {
          "count": {"enum": [64, 65, 256, 512]},
          "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 1000},
          "unresolved_identities": {"type": "array", "maxItems": 0},
          "ticket_preparations": {"type": "integer", "minimum": 0},
          "tickets_prepared": {"type": "integer", "minimum": 0},
          "ticket_preparation_failures": {"const": 0},
          "ticket_bytes": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "unavailable"}]},
          "ticket_owner_fields": {"const": 0}
        }
      }
    }
  }
}
