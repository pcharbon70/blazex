{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-05/cleanup-scaling-v0.1.0.json",
  "title": "BH-05 Phase 13 cleanup scaling raw evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "support_state",
    "execution_state",
    "acceptance_state",
    "environment",
    "contract",
    "phase12_raw_sha256",
    "retained_failed_trials",
    "samples",
    "shape",
    "phase12_fixture_repeat",
    "commands",
    "command_outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase": {"const": 13},
    "support_state": {"const": "unsupported"},
    "execution_state": {"enum": ["executed", "failed"]},
    "acceptance_state": {"enum": ["passed", "failed"]},
    "environment": {"type": "object"},
    "contract": {
      "type": "object",
      "required": ["deadline_ms", "page_size", "maximum_page_size", "fixture_count"],
      "properties": {
        "deadline_ms": {"const": 1000},
        "page_size": {"const": 64},
        "maximum_page_size": {"const": 128},
        "fixture_count": {"const": 512}
      }
    },
    "phase12_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retained_failed_trials": {"type": "array", "minItems": 3},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime",
          "payload_class",
          "count",
          "sample",
          "retained",
          "execution_state",
          "acceptance_state",
          "elapsed_ms",
          "exceeded_deadline",
          "terminal_leases",
          "unresolved_identities",
          "lost_closed_identities",
          "amplification",
          "runtime_metrics",
          "stage_timings_ms",
          "raw_sha256"
        ]
      }
    },
    "shape": {
      "type": "object",
      "required": ["method", "absolute_alarm_ms", "relative_alarm", "minimum_count", "alarms"]
    },
    "phase12_fixture_repeat": {"type": "object"},
    "commands": {"type": "object"},
    "command_outputs": {"type": "object"}
  }
}
