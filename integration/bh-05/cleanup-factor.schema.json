{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazex.dev/schemas/bh-05/cleanup-factor-v1.json",
  "title": "BH-05 factorized cleanup observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_state", "acceptance_state", "result", "factor_profiles", "samples"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "execution_state": {"const": "executed"},
    "acceptance_state": {"enum": ["passed", "failed"]},
    "result": {"enum": ["passed", "failed"]},
    "factor_profiles": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"const": "inventory_only"}},
        {"contains": {"const": "payload_only"}},
        {"contains": {"const": "identifier_only"}},
        {"contains": {"const": "owner_depth_only"}},
        {"contains": {"const": "distribution_only"}},
        {"contains": {"const": "outcome_retention"}},
        {"contains": {"const": "maximum"}}
      ]
    },
    "samples": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["payload_class", "count", "elapsed_ms", "unresolved_identities", "amplification", "outcome_format"],
        "properties": {
          "count": {"enum": [256, 512]},
          "elapsed_ms": {"type": "integer", "minimum": 0},
          "unresolved_identities": {"type": "array"},
          "outcome_format": {
            "type": "object",
            "required": ["version", "owner_records", "retained_outcome_bytes", "retained_owner_records"],
            "properties": {
              "version": {"const": 2},
              "owner_records": {"const": 0},
              "retained_owner_records": {"const": 0},
              "retained_outcome_bytes": {
                "oneOf": [{"type": "integer", "minimum": 0}, {"const": "unavailable"}]
              }
            }
          },
          "amplification": {
            "type": "object",
            "required": ["ticket_preparations", "tickets_prepared", "ticket_preparation_failures", "ticket_preparation_pages", "ticket_bytes", "ticket_owner_fields", "compact_ack_pages", "compact_ack_items", "positional_result_items"],
            "properties": {
              "ticket_preparations": {"type": "integer", "minimum": 0},
              "tickets_prepared": {"type": "integer", "minimum": 0},
              "ticket_preparation_failures": {"const": 0},
              "ticket_preparation_pages": {"type": "integer", "minimum": 0},
              "ticket_bytes": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "unavailable"}]},
              "ticket_owner_fields": {"const": 0},
              "compact_ack_pages": {"type": "integer", "minimum": 0},
              "compact_ack_items": {"type": "integer", "minimum": 0},
              "positional_result_items": {"const": 0}
            }
          }
        }
      }
    }
  }
}
